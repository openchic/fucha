{
  "name": "fucha",
  "version": "0.1.0",
  "description": "Turn a web link into a publish-ready WeChat article.",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openchic/fucha.git"
  },
  "scripts": {
    "build": "pnpm typecheck && electron-vite build",
    "build:linux": "pnpm build && electron-builder --linux --publish never",
    "build:mac": "pnpm build && electron-builder --mac --publish never",
    "build:mac:debug": "pnpm typecheck && electron-vite build --mode debug && electron-builder --config electron-builder.debug.yml --mac --publish never",
    "build:unpack": "pnpm build && electron-builder --dir --publish never",
    "build:win": "pnpm build && electron-builder --win --publish never",
    "dev": "electron-vite dev --watch",
    "format": "prettier --write .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint --cache .",
    "prepare": "husky",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && node scripts/build-e2e.mjs && playwright test",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web && pnpm typecheck:test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mozilla/readability": "^0.6.0",
    "@uiw/react-color": "^2.10.3",
    "dompurify": "^3.4.15",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.12.0",
    "juice": "^12.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/mozilla-readability": "^0.2.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vainjs/eslint-config": "^0.1.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.1.0"
  }
}
